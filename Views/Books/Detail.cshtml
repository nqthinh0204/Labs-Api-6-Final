@model BookDetailViewModel
@{
    ViewData["Title"] = "Chi Tiết Sách";
}

<div class="page-header">
    <div>
        <h2 class="page-title">@Model.Title</h2>
        <p class="page-description">Mã sách: @Model.BookCode</p>
    </div>
    <a class="btn" asp-action="Index">← Danh sách</a>
</div>

<div class="product-card" style="max-width:640px">
    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <img src="@Model.CoverImageUrl" alt="Ảnh bìa @Model.Title" class="cover-preview" />
    }
    <table class="table">
        <tr><th>Tác giả</th><td>@Model.Author</td></tr>
        <tr><th>Nhà xuất bản</th><td>@Model.Publisher</td></tr>
        <tr><th>Giá</th><td>@Model.Price.ToString("N0") VNĐ</td></tr>
        <tr><th>Tồn kho</th><td>@Model.Quantity @(Model.IsLowStock ? "(thấp)" : "")</td></tr>
        <tr><th>Tồn kho tối thiểu</th><td>@Model.MinStock</td></tr>
        <tr><th>Thể loại</th><td>@Model.GenreName</td></tr>
        <tr><th>CreatedAt</th><td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
        <tr><th>UpdatedAt</th><td>@(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td></tr>
    </table>
    <div class="card-actions">
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
            <a class="btn" asp-action="UploadImage" asp-route-id="@Model.Id">Ảnh bìa</a>
            <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id">Xóa</a>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
            <a class="btn" asp-action="AdjustStock" asp-route-id="@Model.Id">Điều chỉnh tồn kho</a>
        }
    </div>
</div>
