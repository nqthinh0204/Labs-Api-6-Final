@model SaleDetailViewModel
@{
    ViewData["Title"] = "Chi Tiết Đơn Bán";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Đơn Bán @Model.SaleCode</h2>
        <p class="page-description">Tạo lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") bởi @(Model.CreatedByUserName ?? "—")</p>
    </div>
    <a class="btn" asp-action="Index">← Lịch sử bán hàng</a>
</div>

<table class="table">
    <thead>
        <tr><th>Sách (snapshot tại thời điểm bán)</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.BookTitleSnapshot</td>
                <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                <td>@item.Quantity</td>
                <td>@item.LineTotal.ToString("N0") VNĐ</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" style="text-align:right">Tổng cộng</th>
            <th>@Model.TotalAmount.ToString("N0") VNĐ</th>
        </tr>
    </tfoot>
</table>
